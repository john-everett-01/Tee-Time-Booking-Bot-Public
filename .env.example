CLUB_MEMBER_NUMBER=
CLUB_PASSWORD=

# Primary partner candidates, comma-separated, tried round-robin up to 5 attempts total
PRIMARY_PARTNERS=Regular Partner One,Regular Partner Two

# Last resort if none of the above are found: fixed time + specific partner, Course A then Course B
LAST_RESORT_PARTNER=Backup Partner
LAST_RESORT_TIME=13:00

# Notification email (SMTP) — optional, but required for success/failure alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
